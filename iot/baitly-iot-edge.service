[Unit]
Description=Baitly dedicated IoT HTTPS ingress
After=network-online.target baitly-iot-firewall.service
Requires=baitly-iot-firewall.service

[Service]
Type=simple
ExecStartPre=/usr/sbin/nginx -t -c /etc/baitly-iot-edge/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/baitly-iot-edge/nginx.conf -g "daemon off;"
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RuntimeDirectory=baitly-iot-edge
LogsDirectory=baitly-iot-edge
ReadWritePaths=/var/log/baitly-iot-edge /run/baitly-iot-edge
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE
LimitNOFILE=1024
MemoryMax=128M

[Install]
WantedBy=multi-user.target
