# ===========================================
# Clenzy Infrastructure - Variables d'environnement
# ===========================================
# Copier ce fichier en .env.dev (dev) ou .env (prod) et adapter les valeurs.
# IMPORTANT : Ne JAMAIS commiter les fichiers .env contenant des secrets !
#
# Usage :
#   DEV  : docker compose -f docker-compose.dev.yml --env-file .env.dev up --build
#   PROD : docker compose -f docker-compose.prod.yml --env-file .env up -d

# ---- Domaines ----
DOMAIN=clenzy.fr
APP_DOMAIN=app.clenzy.fr
AUTH_DOMAIN=auth.clenzy.fr
PROMETHEUS_DOMAIN=prometheus.clenzy.fr
KAFKA_UI_DOMAIN=kafka.clenzy.fr

# ---- PostgreSQL ----
POSTGRES_DB=clenzy_prod
POSTGRES_USER=clenzy_prod_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password
# Replication password (pour le read replica — defaut: meme que POSTGRES_PASSWORD)
POSTGRES_REPLICATION_PASSWORD=CHANGE_ME_strong_password

# ─────────────────────────────────────────────────────────────────────────────
# Role applicatif non-superuser — audit securite 2026-07-26, plan REM-T-02
# ─────────────────────────────────────────────────────────────────────────────
# POURQUOI : le compte ci-dessus est SUPERUSER, et un superuser contourne la
# Row-Level Security *meme* posee et FORCEE. Tant que l'application s'y connecte,
# activer la RLS n'apporterait aucune protection — seulement une fausse assurance.
#
# Tout se pilote depuis ce fichier : aucune commande a passer sur le VPS. Le
# service one-shot `db-app-role` cree le role a chaque deploiement (idempotent),
# et le changeset Liquibase 0362 lui accorde les privileges DML au boot.
#
# ── ETAPE 1 — creer le role, sans rien basculer ──────────────────────────────
# Decommenter cette seule ligne, recharger le secret, deployer.
# Effet : le role clenzy_app est cree (NOSUPERUSER, NOBYPASSRLS), ajoute au
# userlist pgbouncer, et recoit ses privileges. L'application continue d'utiliser
# le compte proprietaire — comportement stric­tement inchange, donc reversible.
# Minimum 24 caracteres (le script refuse en dessous).
# CLENZY_APP_DB_PASSWORD=CHANGE_ME_role_applicatif_24_caracteres_minimum
#
# ── ETAPE 2 — basculer l'application sur ce role ─────────────────────────────
# A ne faire qu'apres un deploiement reussi de l'etape 1.
# Decommenter les DEUX lignes ensemble : n'en poser qu'une donnerait un
# identifiant d'un compte avec le mot de passe de l'autre, et l'application ne
# pourrait plus se connecter.
# CLENZY_APP_DB_USER_PASSWORD doit valoir exactement CLENZY_APP_DB_PASSWORD.
# CLENZY_APP_DB_USER=clenzy_app
# CLENZY_APP_DB_USER_PASSWORD=CHANGE_ME_meme_valeur_que_CLENZY_APP_DB_PASSWORD
#
# Liquibase continue d'utiliser le compte proprietaire : le DDL des futurs
# changesets exige la propriete des tables, que le role applicatif n'a pas.
#
# ROLLBACK : recommenter les lignes de l'etape 2 et redeployer. Le role et ses
# privileges peuvent rester en place, ils ne retirent rien a personne.
#
# La RLS (contexte Liquibase `rls`, puis strict-context) ne doit etre activee
# qu'une fois l'etape 2 en production et stable.

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_redis_password

# ---- Keycloak ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_password
KEYCLOAK_DB_NAME=keycloak_prod
# Keycloak utilise POSTGRES_USER/POSTGRES_PASSWORD pour se connecter a PostgreSQL
KEYCLOAK_HOSTNAME=auth.clenzy.fr
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_keycloak_client_secret

# ---- Backend Spring Boot ----
JWT_SECRET=CHANGE_ME_jwt_secret_min_256_bits
SPRING_PROFILES_ACTIVE=prod

# ---- Stripe (Paiements) ----
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ---- CORS ----
# Origins autorisees pour l'API backend (separes par virgule, sans espace).
# Doit inclure :
# - https://app.clenzy.fr : PMS frontend (consomme l'API en cross-origin via Bearer)
# - https://clenzy.fr     : Landing page (apex, soumission devis publique)
# - https://www.clenzy.fr : Landing page (sous-domaine www, doit etre autorise meme si redirige vers apex)
ALLOWED_ORIGINS=https://app.clenzy.fr,https://clenzy.fr,https://www.clenzy.fr

# ---- Monitoring (Grafana) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password
MONITORING_DOMAIN=monitoring.clenzy.fr

# ---- Let's Encrypt ----
LETSENCRYPT_EMAIL=admin@clenzy.fr
# Nom du certificat dans /etc/letsencrypt/live (par défaut: DOMAIN)
CERTBOT_CERT_NAME=clenzy.fr

# ---- Landing Page ----
VITE_APP_URL=https://app.clenzy.fr

# ---- Email SMTP (envoi via Brevo) ----
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_brevo_login
MAIL_PASSWORD=CHANGE_ME_brevo_smtp_key
# Brevo utilise le port 587 (STARTTLS)
MAIL_SMTP_SSL_ENABLE=false
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true

# ---- Email IMAP (réception via info@clenzy.fr) ----
IMAP_HOST=mail.clenzy.fr
IMAP_PORT=993
IMAP_USERNAME=info@clenzy.fr
IMAP_PASSWORD=CHANGE_ME_mail_password
IMAP_ENABLED=true

# ---- Jasypt (chiffrement tokens) ----
JASYPT_ENCRYPTOR_PASSWORD=CHANGE_ME_jasypt_password

# ---- Stripe Currency ----
STRIPE_CURRENCY=eur

# ---- Mapbox (carte dans les emails check-in) ----
MAPBOX_ACCESS_TOKEN=

# ---- Airbnb Integration (optionnel) ----
AIRBNB_CLIENT_ID=
AIRBNB_CLIENT_SECRET=
AIRBNB_REDIRECT_URI=https://app.clenzy.fr/api/airbnb/callback
AIRBNB_WEBHOOK_SECRET=

# ---- Kafka (KRaft) ----
# ID cluster KRaft (base64, 22 chars) — OBLIGATOIRE, garder stable une fois en prod
# Générer avec : head -c 16 /dev/urandom | base64 | head -c 22
KAFKA_CLUSTER_ID=CHANGE_ME_kafka_cluster_id

# ---- GitHub Container Registry (CD) ----
# Token PAT pour pull les images Docker depuis ghcr.io
# Créer sur : https://github.com/settings/tokens → "read:packages"
GHCR_TOKEN=ghp_CHANGE_ME

# ---- Read Replica (optionnel — decommenter quand le replica est actif) ----
# SPRING_DATASOURCE_REPLICA_URL=jdbc:postgresql://postgres-replica:5432/clenzy_prod?sslmode=prefer

# ---- k6 Load Testing (optionnel) ----
# Token JWT pour les tests authentifies
# K6_AUTH_TOKEN=

# ---- Identifiants par defaut (NE PAS UTILISER EN PROD) ----
# PMS_DEFAULT_USER=admin@clenzy.fr
# PMS_DEFAULT_PASSWORD=CHANGE_ME
